{
  "kerf-comfy": 1,
  "about": "A still: one picture from the prompt, or of who or what a reference picture shows (ref=), to hand a later step as its ref= or its first=, or to be a shot of its own. It is one frame of the model that makes the shots, so it looks as they do.",
  "frames": {
    "most": 1,
    "step": 1
  },
  "size": [
    832,
    480
  ],
  "multiple": 16,
  "set": {
    "negative": "blurry, low quality, text, watermark",
    "steps": 20,
    "cfg": 6.0,
    "shift": 8.0,
    "strength": 1.0,
    "sampler": "uni_pc",
    "scheduler": "simple",
    "unet": "wan2.1_vace_1.3B_fp16.safetensors",
    "vae": "wan_2.1_vae.safetensors",
    "text_encoder": "umt5_xxl_fp16.safetensors"
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{unet}",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{text_encoder}",
        "type": "wan"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{vae}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "{prompt}"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "{negative}"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{ref}"
      }
    },
    "9": {
      "class_type": "WanVaceToVideo",
      "inputs": {
        "positive": [
          "4",
          0
        ],
        "negative": [
          "5",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "width": "{width}",
        "height": "{height}",
        "length": "{frames}",
        "batch_size": 1,
        "strength": "{strength}",
        "reference_image": [
          "8",
          0
        ]
      }
    },
    "10": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": "{shift}"
      }
    },
    "12": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "10",
          0
        ],
        "positive": [
          "9",
          0
        ],
        "negative": [
          "9",
          1
        ],
        "latent_image": [
          "9",
          2
        ],
        "seed": "{seed}",
        "steps": "{steps}",
        "cfg": "{cfg}",
        "sampler_name": "{sampler}",
        "scheduler": "{scheduler}",
        "denoise": 1.0
      }
    },
    "13": {
      "class_type": "TrimVideoLatent",
      "inputs": {
        "samples": [
          "12",
          0
        ],
        "trim_amount": [
          "9",
          3
        ]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "16": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "14",
          0
        ],
        "filename_prefix": "kerf"
      }
    }
  }
}
