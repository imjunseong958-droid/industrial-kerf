{
  "kerf-comfy": 1,
  "about": "A shot directed by all four at once: it follows a depth guide (guide=, drawn with pass=depth), looks like a reference picture (ref=), has its subject go where a clip of the guide's sequence goes (moves=<clip>, its box on each frame laid over the guide as a layout), and lets the guide go on the frames where a signal is 1 (signal=<clip>), which are then made from the prompt, the reference and the layout alone. With a first frame beside the guide (first=), it starts as that picture and goes on from it: a part of a longer shot starts as the last frame of the part before. Any of them can be left off the line. moves_strength is how hard the layout holds beside the guide's strength.",
  "fps": 16,
  "frames": {
    "most": 81,
    "step": 4
  },
  "size": [
    832,
    480
  ],
  "multiple": 16,
  "set": {
    "negative": "blurry, low quality, static, text, watermark",
    "steps": 20,
    "cfg": 6.0,
    "shift": 8.0,
    "strength": 1.0,
    "cache": 0.2,
    "sampler": "uni_pc",
    "scheduler": "simple",
    "unet": "wan2.1_vace_14B_fp16.safetensors",
    "vae": "wan_2.1_vae.safetensors",
    "text_encoder": "umt5_xxl_fp16.safetensors",
    "moves_strength": 1.0
  },
  "without": {
    "24": {
      "wants": [
        "mask"
      ],
      "reads": "7"
    },
    "22": {
      "wants": [
        "control_video"
      ],
      "reads": "9"
    },
    "33": {
      "wants": [
        "image1",
        "image2"
      ],
      "reads": "24"
    },
    "38": {
      "given": [
        "first",
        "guide"
      ]
    }
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{unet}",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{text_encoder}",
        "type": "wan"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{vae}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "{prompt}"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "{negative}"
      }
    },
    "6": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "{guide}"
      }
    },
    "7": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "6",
          0
        ]
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{ref}"
      }
    },
    "9": {
      "class_type": "WanVaceToVideo",
      "inputs": {
        "positive": [
          "4",
          0
        ],
        "negative": [
          "5",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "width": "{width}",
        "height": "{height}",
        "length": "{frames}",
        "batch_size": 1,
        "strength": "{strength}",
        "control_video": [
          "33",
          0
        ],
        "reference_image": [
          "8",
          0
        ],
        "control_masks": [
          "38",
          0
        ]
      }
    },
    "10": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": "{shift}"
      }
    },
    "11": {
      "class_type": "EasyCache",
      "inputs": {
        "model": [
          "10",
          0
        ],
        "reuse_threshold": "{cache}",
        "start_percent": 0.15,
        "end_percent": 0.95,
        "verbose": false
      }
    },
    "12": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "11",
          0
        ],
        "positive": [
          "22",
          0
        ],
        "negative": [
          "22",
          1
        ],
        "latent_image": [
          "22",
          2
        ],
        "seed": "{seed}",
        "steps": "{steps}",
        "cfg": "{cfg}",
        "sampler_name": "{sampler}",
        "scheduler": "{scheduler}",
        "denoise": 1.0
      }
    },
    "13": {
      "class_type": "TrimVideoLatent",
      "inputs": {
        "samples": [
          "12",
          0
        ],
        "trim_amount": [
          "22",
          3
        ]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "15": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "14",
          0
        ],
        "fps": "{fps}"
      }
    },
    "16": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "15",
          0
        ],
        "filename_prefix": "video/kerf",
        "format": "auto",
        "format.codec": "auto"
      }
    },
    "17": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "{signal_video}"
      }
    },
    "18": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "17",
          0
        ]
      }
    },
    "19": {
      "class_type": "ImageToMask",
      "inputs": {
        "image": [
          "18",
          0
        ],
        "channel": "red"
      }
    },
    "23": {
      "class_type": "EmptyImage",
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "batch_size": 1,
        "color": 8421504
      }
    },
    "24": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "7",
          0
        ],
        "source": [
          "23",
          0
        ],
        "x": 0,
        "y": 0,
        "resize_source": false,
        "mask": [
          "19",
          0
        ]
      }
    },
    "20": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "{moves_video}"
      }
    },
    "21": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "20",
          0
        ]
      }
    },
    "22": {
      "class_type": "WanVaceToVideo",
      "inputs": {
        "positive": [
          "9",
          0
        ],
        "negative": [
          "9",
          1
        ],
        "vae": [
          "3",
          0
        ],
        "width": "{width}",
        "height": "{height}",
        "length": "{frames}",
        "batch_size": 1,
        "strength": "{moves_strength}",
        "control_video": [
          "21",
          0
        ],
        "reference_image": [
          "8",
          0
        ]
      }
    },
    "30": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{first}"
      }
    },
    "31": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "30",
          0
        ],
        "upscale_method": "lanczos",
        "width": "{width}",
        "height": "{height}",
        "crop": "center"
      }
    },
    "32": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "24",
          0
        ],
        "batch_index": 1,
        "length": "{frames}"
      }
    },
    "33": {
      "class_type": "ImageBatch",
      "inputs": {
        "image1": [
          "31",
          0
        ],
        "image2": [
          "32",
          0
        ]
      }
    },
    "34": {
      "class_type": "EmptyImage",
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "batch_size": 1,
        "color": 0
      }
    },
    "35": {
      "class_type": "EmptyImage",
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "batch_size": "{frames}",
        "color": 16777215
      }
    },
    "36": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "35",
          0
        ],
        "batch_index": 1,
        "length": "{frames}"
      }
    },
    "37": {
      "class_type": "ImageBatch",
      "inputs": {
        "image1": [
          "34",
          0
        ],
        "image2": [
          "36",
          0
        ]
      }
    },
    "38": {
      "class_type": "ImageToMask",
      "inputs": {
        "image": [
          "37",
          0
        ],
        "channel": "red"
      }
    }
  }
}
