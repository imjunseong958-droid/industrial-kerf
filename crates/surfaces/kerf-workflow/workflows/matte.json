{
  "kerf-comfy": 1,
  "about": "What a guide shows of the thing the prompt names, as a matte: the thing in white on black on every frame, at the guide's own size, rate, and frames, as render with matte=<clip> draws one of a clip. The prompt is what to find, in a word or a few (man, black pickup truck), with a comma between things of more than one kind (car, bus). Each is found where it comes into the picture and followed from there. inside=\"x,y x,y\" names a thing by points on it in the first frame in place of the prompt, each 0 to 1 across and down, with outside= for points off it: that thing alone is followed. objects=<n> is how many things are followed at most, and which=<n,n> keeps some of them, by the numbers matte-shown draws on them.",
  "of": "guide",
  "frames": { "most": 480, "step": 1 },
  "size": [1920, 1080],
  "multiple": 2,
  "set": {
    "model": "sam3.1_multiplex_fp16.safetensors",
    "threshold": 0.5,
    "objects": 4,
    "every": 1,
    "which": "",
    "refine": 2,
    "inside": "",
    "outside": ""
  },
  "without": { "4": { "given": ["prompt"] }, "13": { "wants": ["positive_coords"] }, "14": { "wants": ["initial_mask"], "reads": "5" } },
  "workflow": {
    "1": { "class_type": "LoadVideo", "inputs": { "file": "{guide}" } },
    "2": { "class_type": "GetVideoComponents", "inputs": { "video": ["1", 0] } },
    "3": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "{model}" } },
    "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 1], "text": "{prompt}" } },
    "10": { "class_type": "ImageFromBatch", "inputs": { "image": ["2", 0], "batch_index": 0, "length": 1 } },
    "11": { "class_type": "PrimitiveStringMultiline", "inputs": { "value": "{inside}" } },
    "12": { "class_type": "PrimitiveStringMultiline", "inputs": { "value": "{outside}" } },
    "13": { "class_type": "SAM3_Detect", "inputs": { "model": ["3", 0], "image": ["10", 0], "positive_coords": ["11", 0], "negative_coords": ["12", 0], "threshold": "{threshold}", "refine_iterations": "{refine}", "individual_masks": true } },
    "5": { "class_type": "SAM3_VideoTrack", "inputs": { "images": ["2", 0], "model": ["3", 0], "conditioning": ["4", 0], "detection_threshold": "{threshold}", "max_objects": "{objects}", "detect_interval": "{every}" } },
    "14": { "class_type": "SAM3_VideoTrack", "inputs": { "images": ["2", 0], "model": ["3", 0], "initial_mask": ["13", 0], "detection_threshold": "{threshold}", "max_objects": "{objects}", "detect_interval": "{every}" } },
    "6": { "class_type": "SAM3_TrackToMask", "inputs": { "track_data": ["14", 0], "object_indices": "{which}" } },
    "7": { "class_type": "MaskToImage", "inputs": { "mask": ["6", 0] } },
    "8": { "class_type": "CreateVideo", "inputs": { "images": ["7", 0], "fps": "{fps}" } },
    "9": { "class_type": "SaveVideo", "inputs": { "video": ["8", 0], "filename_prefix": "video/kerf", "format": "auto", "format.codec": "auto" } }
  }
}
