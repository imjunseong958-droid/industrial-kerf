{
  "kerf-comfy": 1,
  "about": "A guide with a thing taken out of it, as a video of the guide's own size, rate, and frames: what guide_mask is white on is gone and what was behind it is there, by a model made for that. The mask is the thing in white on black, as matte finds it in footage. The prompt says what the picture shows once the thing is gone, and not what to take out. Where the mask is black the plate is the guide's own pixels. grow=<pixels> takes out that much around the mask as well. reach=<pixels> lays the model's picture back that much further again, for what the thing left on what is around it, a shadow, which the model takes out and the mask does not cover. It is made in one pass of the model's two; refine=true has the second go over it, in not quite twice the time. At most 197 frames.",
  "of": "guide",
  "frames": { "most": 197, "step": 1 },
  "size": [1920, 1080],
  "multiple": 2,
  "set": {
    "negative": "",
    "steps": 30,
    "cfg": 6.0,
    "scheduler": "simple",
    "grow": 8,
    "reach": 0,
    "feather": 9,
    "refine": false,
    "area": 258048,
    "unet": "void_pass1.safetensors",
    "unet2": "void_pass2.safetensors",
    "vae": "cogvideox_vae.safetensors",
    "text_encoder": "t5xxl_fp16.safetensors",
    "flow": "raft_large_C_T_SKHT_V2-ff5fadd5.safetensors"
  },
  "without": { "58": { "wants": ["on_true", "on_false"] } },
  "workflow": {
    "1": { "class_type": "LoadVideo", "inputs": { "file": "{guide}" } },
    "2": { "class_type": "GetVideoComponents", "inputs": { "video": ["1", 0] } },
    "3": { "class_type": "LoadVideo", "inputs": { "file": "{guide_mask}" } },
    "4": { "class_type": "GetVideoComponents", "inputs": { "video": ["3", 0] } },
    "5": { "class_type": "ImageToMask", "inputs": { "image": ["4", 0], "channel": "red" } },
    "6": { "class_type": "GrowMask", "inputs": { "mask": ["5", 0], "expand": "{grow}", "tapered_corners": true } },
    "7": { "class_type": "MaskToImage", "inputs": { "mask": ["6", 0] } },
    "8": { "class_type": "GrowMask", "inputs": { "mask": ["6", 0], "expand": "{reach}", "tapered_corners": true } },
    "9": { "class_type": "MaskToImage", "inputs": { "mask": ["8", 0] } },

    "10": { "class_type": "ComfyMathExpression", "inputs": { "expression": "max(16, round(a * min(1, sqrt(c / (a * b))) / 8) * 8)", "values.a": "{width}", "values.b": "{height}", "values.c": "{area}" } },
    "11": { "class_type": "ComfyMathExpression", "inputs": { "expression": "max(16, round(b * min(1, sqrt(c / (a * b))) / 8) * 8)", "values.a": "{width}", "values.b": "{height}", "values.c": "{area}" } },
    "12": { "class_type": "ComfyMathExpression", "inputs": { "expression": "ceil(max(a - 5, 0) / 8) * 8 + 5", "values.a": "{frames}" } },

    "13": { "class_type": "ImageFromBatch", "inputs": { "image": ["2", 0], "batch_index": -1, "length": 1 } },
    "14": { "class_type": "RepeatImageBatch", "inputs": { "image": ["13", 0], "amount": 8 } },
    "15": { "class_type": "ImageBatch", "inputs": { "image1": ["2", 0], "image2": ["14", 0] } },
    "16": { "class_type": "ImageScale", "inputs": { "image": ["15", 0], "upscale_method": "area", "width": ["10", 1], "height": ["11", 1], "crop": "disabled" } },
    "17": { "class_type": "ImageFromBatch", "inputs": { "image": ["7", 0], "batch_index": -1, "length": 1 } },
    "18": { "class_type": "RepeatImageBatch", "inputs": { "image": ["17", 0], "amount": 8 } },
    "19": { "class_type": "ImageBatch", "inputs": { "image1": ["7", 0], "image2": ["18", 0] } },
    "20": { "class_type": "ImageScale", "inputs": { "image": ["19", 0], "upscale_method": "area", "width": ["10", 1], "height": ["11", 1], "crop": "disabled" } },
    "21": { "class_type": "ImageToMask", "inputs": { "image": ["20", 0], "channel": "red" } },
    "22": { "class_type": "ThresholdMask", "inputs": { "mask": ["21", 0], "value": 0.5 } },

    "30": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{text_encoder}", "type": "cogvideox", "device": "default" } },
    "31": { "class_type": "VAELoader", "inputs": { "vae_name": "{vae}" } },
    "32": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["30", 0], "text": "{prompt}" } },
    "33": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["30", 0], "text": "{negative}" } },
    "34": { "class_type": "VOIDInpaintConditioning", "inputs": { "positive": ["32", 0], "negative": ["33", 0], "vae": ["31", 0], "video": ["16", 0], "quadmask": ["22", 0], "width": ["10", 1], "height": ["11", 1], "length": ["12", 1], "batch_size": 1 } },

    "40": { "class_type": "UNETLoader", "inputs": { "unet_name": "{unet}", "weight_dtype": "default" } },
    "41": { "class_type": "CFGGuider", "inputs": { "model": ["40", 0], "positive": ["34", 0], "negative": ["34", 1], "cfg": "{cfg}" } },
    "42": { "class_type": "BasicScheduler", "inputs": { "model": ["40", 0], "scheduler": "{scheduler}", "steps": "{steps}", "denoise": 1.0 } },
    "43": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{seed}" } },
    "44": { "class_type": "VOIDSampler", "inputs": {} },
    "45": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["43", 0], "guider": ["41", 0], "sampler": ["44", 0], "sigmas": ["42", 0], "latent_image": ["34", 2] } },
    "46": { "class_type": "VAEDecode", "inputs": { "samples": ["45", 0], "vae": ["31", 0] } },

    "50": { "class_type": "OpticalFlowLoader", "inputs": { "model_name": "{flow}" } },
    "51": { "class_type": "VOIDWarpedNoise", "inputs": { "optical_flow": ["50", 0], "video": ["46", 0], "width": ["10", 1], "height": ["11", 1], "length": ["12", 1], "batch_size": 1 } },
    "52": { "class_type": "VOIDWarpedNoiseSource", "inputs": { "warped_noise": ["51", 0] } },
    "53": { "class_type": "UNETLoader", "inputs": { "unet_name": "{unet2}", "weight_dtype": "default" } },
    "54": { "class_type": "CFGGuider", "inputs": { "model": ["53", 0], "positive": ["34", 0], "negative": ["34", 1], "cfg": "{cfg}" } },
    "55": { "class_type": "BasicScheduler", "inputs": { "model": ["53", 0], "scheduler": "{scheduler}", "steps": "{steps}", "denoise": 1.0 } },
    "56": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["52", 0], "guider": ["54", 0], "sampler": ["44", 0], "sigmas": ["55", 0], "latent_image": ["34", 2] } },
    "57": { "class_type": "VAEDecode", "inputs": { "samples": ["56", 0], "vae": ["31", 0] } },
    "58": { "class_type": "ComfySwitchNode", "inputs": { "switch": "{refine}", "on_true": ["57", 0], "on_false": ["46", 0] } },

    "60": { "class_type": "ImageFromBatch", "inputs": { "image": ["58", 0], "batch_index": 0, "length": "{frames}" } },
    "61": { "class_type": "ImageScale", "inputs": { "image": ["60", 0], "upscale_method": "lanczos", "width": "{width}", "height": "{height}", "crop": "disabled" } },
    "62": { "class_type": "ImageBlur", "inputs": { "image": ["9", 0], "blur_radius": "{feather}", "sigma": 4.0 } },
    "63": { "class_type": "ImageToMask", "inputs": { "image": ["62", 0], "channel": "red" } },
    "64": { "class_type": "ImageCompositeMasked", "inputs": { "destination": ["2", 0], "source": ["61", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["63", 0] } },
    "65": { "class_type": "CreateVideo", "inputs": { "images": ["64", 0], "fps": "{fps}" } },
    "66": { "class_type": "SaveVideo", "inputs": { "video": ["65", 0], "filename_prefix": "video/kerf", "format": "auto", "format.codec": "auto" } }
  }
}
