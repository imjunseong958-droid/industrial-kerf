kerf-look 1
look look.film version=2 name="Film" category="Retro" on=clip
  doc "A film finish laid over a cut: grain and darkened corners; vlogs, travel, and nostalgic edits."
  param amount number default=1 range=0..2 doc="How strong the film look is."
  fx noise.addgrain@1 tweaking/intensity=0.5*$amount
  fx stylize.vignette@2 amount=-30*$amount
