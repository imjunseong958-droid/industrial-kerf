kerf-look 1
look look.travel-motion version=1 name="Travel Motion" category="Transitions" on=transition
  doc "Zooms out, travels across, and lands on the next shot; journeys and montages."
  param direction choice options=from-north|from-east|from-south|from-west default=from-west doc="Which side the next shot comes from."
  param zoom number default=0.4 range=0..0.9 doc="How far out it zooms on the way."
  param motion_blur number default=0.5 range=0..1 doc="How much the move smears."
  a set x={0%:0 5%:$direction[0,-0.001,0,0.001] 10%:$direction[0,-1,0,1]*(0.004-0.001*$zoom) 15%:$direction[0,-1,0,1]*(0.015-0.008*$zoom) 20%:$direction[0,-1,0,1]*(0.035-0.024*$zoom) 25%:$direction[0,-1,0,1]*(0.068-0.057*$zoom) 30%:$direction[0,-1,0,1]*(0.117-0.109*$zoom) 35%:$direction[0,-1,0,1]*(0.185-0.181*$zoom) 40%:$direction[0,-1,0,1]*(0.276-0.275*$zoom) 45%:$direction[0,-1,0,1]*(0.394-0.394*$zoom) 50%:$direction[0,-1,0,1]*(0.54-0.54*$zoom) 55%:$direction[0,-1,0,1]*(0.686-0.686*$zoom) 60%:$direction[0,-1,0,1]*(0.804-0.8*$zoom) 65%:$direction[0,-1,0,1]*(0.895-0.874*$zoom) 70%:$direction[0,-1,0,1]*(0.963-0.897*$zoom) 75%:$direction[0,-1,0,1]*(1.013-0.854*$zoom) 80%:$direction[0,-1,0,1]*(1.045-0.737*$zoom) 85%:$direction[0,-1,0,1]*(1.065-0.549*$zoom) 90%:$direction[0,-1,0,1]*(1.076-0.318*$zoom) 95%:$direction[0,-1,0,1]*(1.079-0.102*$zoom) 100%:$direction[0,-1.08,0,1.08]}
  a set y={0%:0 5%:$direction[0.001,0,-0.001,0] 10%:$direction[1,0,-1,0]*(0.004-0.001*$zoom) 15%:$direction[1,0,-1,0]*(0.015-0.008*$zoom) 20%:$direction[1,0,-1,0]*(0.035-0.024*$zoom) 25%:$direction[1,0,-1,0]*(0.068-0.057*$zoom) 30%:$direction[1,0,-1,0]*(0.117-0.109*$zoom) 35%:$direction[1,0,-1,0]*(0.185-0.181*$zoom) 40%:$direction[1,0,-1,0]*(0.276-0.275*$zoom) 45%:$direction[1,0,-1,0]*(0.394-0.394*$zoom) 50%:$direction[1,0,-1,0]*(0.54-0.54*$zoom) 55%:$direction[1,0,-1,0]*(0.686-0.686*$zoom) 60%:$direction[1,0,-1,0]*(0.804-0.8*$zoom) 65%:$direction[1,0,-1,0]*(0.895-0.874*$zoom) 70%:$direction[1,0,-1,0]*(0.963-0.897*$zoom) 75%:$direction[1,0,-1,0]*(1.013-0.854*$zoom) 80%:$direction[1,0,-1,0]*(1.045-0.737*$zoom) 85%:$direction[1,0,-1,0]*(1.065-0.549*$zoom) 90%:$direction[1,0,-1,0]*(1.076-0.318*$zoom) 95%:$direction[1,0,-1,0]*(1.079-0.102*$zoom) 100%:$direction[1.08,0,-1.08,0]}
  a set scale={0%:1 5%:1-0.095*$zoom 10%:1-0.295*$zoom 15%:1-0.515*$zoom 20%:1-0.705*$zoom 25%:1-0.844*$zoom 30%:1-0.931*$zoom 35%:1-0.977*$zoom 40%:1-0.995*$zoom 45%:1-$zoom 50%:1-$zoom 55%:1-$zoom 60%:1-0.995*$zoom 65%:1-0.977*$zoom 70%:1-0.931*$zoom 75%:1-0.844*$zoom 80%:1-0.705*$zoom 85%:1-0.515*$zoom 90%:1-0.295*$zoom 95%:1-0.095*$zoom 100%:1}
  b set x={0%:$direction[0,1.08,0,-1.08] 5%:$direction[0,-1,0,1]*(-1.079+0.102*$zoom) 10%:$direction[0,-1,0,1]*(-1.076+0.318*$zoom) 15%:$direction[0,-1,0,1]*(-1.065+0.549*$zoom) 20%:$direction[0,-1,0,1]*(-1.045+0.737*$zoom) 25%:$direction[0,-1,0,1]*(-1.013+0.854*$zoom) 30%:$direction[0,-1,0,1]*(-0.963+0.897*$zoom) 35%:$direction[0,-1,0,1]*(-0.895+0.874*$zoom) 40%:$direction[0,-1,0,1]*(-0.804+0.8*$zoom) 45%:$direction[0,-1,0,1]*(-0.686+0.686*$zoom) 50%:$direction[0,-1,0,1]*(-0.54+0.54*$zoom) 55%:$direction[0,-1,0,1]*(-0.394+0.394*$zoom) 60%:$direction[0,-1,0,1]*(-0.276+0.275*$zoom) 65%:$direction[0,-1,0,1]*(-0.185+0.181*$zoom) 70%:$direction[0,-1,0,1]*(-0.117+0.109*$zoom) 75%:$direction[0,-1,0,1]*(-0.068+0.057*$zoom) 80%:$direction[0,-1,0,1]*(-0.035+0.024*$zoom) 85%:$direction[0,-1,0,1]*(-0.015+0.008*$zoom) 90%:$direction[0,-1,0,1]*(-0.004+0.001*$zoom) 95%:$direction[0,0.001,0,-0.001] 100%:0}
  b set y={0%:$direction[-1.08,0,1.08,0] 5%:$direction[1,0,-1,0]*(-1.079+0.102*$zoom) 10%:$direction[1,0,-1,0]*(-1.076+0.318*$zoom) 15%:$direction[1,0,-1,0]*(-1.065+0.549*$zoom) 20%:$direction[1,0,-1,0]*(-1.045+0.737*$zoom) 25%:$direction[1,0,-1,0]*(-1.013+0.854*$zoom) 30%:$direction[1,0,-1,0]*(-0.963+0.897*$zoom) 35%:$direction[1,0,-1,0]*(-0.895+0.874*$zoom) 40%:$direction[1,0,-1,0]*(-0.804+0.8*$zoom) 45%:$direction[1,0,-1,0]*(-0.686+0.686*$zoom) 50%:$direction[1,0,-1,0]*(-0.54+0.54*$zoom) 55%:$direction[1,0,-1,0]*(-0.394+0.394*$zoom) 60%:$direction[1,0,-1,0]*(-0.276+0.275*$zoom) 65%:$direction[1,0,-1,0]*(-0.185+0.181*$zoom) 70%:$direction[1,0,-1,0]*(-0.117+0.109*$zoom) 75%:$direction[1,0,-1,0]*(-0.068+0.057*$zoom) 80%:$direction[1,0,-1,0]*(-0.035+0.024*$zoom) 85%:$direction[1,0,-1,0]*(-0.015+0.008*$zoom) 90%:$direction[1,0,-1,0]*(-0.004+0.001*$zoom) 95%:$direction[-0.001,0,0.001,0] 100%:0}
  b set scale={0%:1 5%:1-0.095*$zoom 10%:1-0.295*$zoom 15%:1-0.515*$zoom 20%:1-0.705*$zoom 25%:1-0.844*$zoom 30%:1-0.931*$zoom 35%:1-0.977*$zoom 40%:1-0.995*$zoom 45%:1-$zoom 50%:1-$zoom 55%:1-$zoom 60%:1-0.995*$zoom 65%:1-0.977*$zoom 70%:1-0.931*$zoom 75%:1-0.844*$zoom 80%:1-0.705*$zoom 85%:1-0.515*$zoom 90%:1-0.295*$zoom 95%:1-0.095*$zoom 100%:1}
  a set shutter={0%:0 5%:345.6*$motion_blur 95%:345.6*$motion_blur 100%:0}
  b set shutter={0%:0 5%:345.6*$motion_blur 95%:345.6*$motion_blur 100%:0}
