kerf-look 1
look look.spring-motion version=1 name="Spring Motion" category="Transitions" on=transition
  doc "Bounces the incoming shot in from a side; light, comic entrances."
  param direction choice options=from-north|from-east|from-south|from-west default=from-west doc="Which side the next shot comes from."
  param bounce number default=0.4 range=0..1 doc="How much it bounces."
  param motion_blur number default=0.5 range=0..1 doc="How much the move smears."
  # Each key is where springs of no bounce, the default and the most have it, and between them.
  a set x={0%:0 3.333%:$direction[0,-1,0,1]*(0.043-0.024*$bounce+0.001*$bounce*$bounce) 6.667%:$direction[0,-1,0,1]*(0.126-0.057*$bounce+0.012*$bounce*$bounce) 10%:$direction[0,-1,0,1]*(0.232-0.08*$bounce+0.043*$bounce*$bounce) 13.333%:$direction[0,-1,0,1]*(0.349-0.079*$bounce+0.107*$bounce*$bounce) 16.667%:$direction[0,-1,0,1]*(0.47-0.054*$bounce+0.205*$bounce*$bounce) 20%:$direction[0,-1,0,1]*(0.585-0.006*$bounce+0.322*$bounce*$bounce) 23.333%:$direction[0,-1,0,1]*(0.691+0.064*$bounce+0.425*$bounce*$bounce) 26.667%:$direction[0,-1,0,1]*(0.783+0.152*$bounce+0.467*$bounce*$bounce) 30%:$direction[0,-1,0,1]*(0.858+0.257*$bounce+0.402*$bounce*$bounce) 33.333%:$direction[0,-1,0,1]*(0.917+0.374*$bounce+0.212*$bounce*$bounce) 36.667%:$direction[0,-1,0,1]*(0.959+0.485*$bounce-0.083*$bounce*$bounce) 40%:$direction[0,-1,0,1]*(0.988+0.567*$bounce-0.411*$bounce*$bounce) 43.333%:$direction[0,-1,0,1]*(1.006+0.59*$bounce-0.672*$bounce*$bounce) 46.667%:$direction[0,-1,0,1]*(1.015+0.532*$bounce-0.773*$bounce*$bounce) 50%:$direction[0,-1,0,1]*(1.018+0.394*$bounce-0.673*$bounce*$bounce) 53.333%:$direction[0,-1,0,1]*(1.017+0.203*$bounce-0.403*$bounce*$bounce) 56.667%:$direction[0,-1,0,1]*(1.015+0.008*$bounce-0.066*$bounce*$bounce) 60%:$direction[0,-1,0,1]*(1.011-0.137*$bounce+0.211*$bounce*$bounce) 63.333%:$direction[0,-1,0,1]*(1.008-0.197*$bounce+0.335*$bounce*$bounce) 66.667%:$direction[0,-1,0,1]*(1.005-0.173*$bounce+0.289*$bounce*$bounce) 70%:$direction[0,-1,0,1]*(1.003-0.098*$bounce+0.14*$bounce*$bounce) 73.333%:$direction[0,-1,0,1]*(1.002-0.02*$bounce-0.011*$bounce*$bounce) 76.667%:$direction[0,-1,0,1]*(1.001+0.024*$bounce-0.084*$bounce*$bounce) 80%:$direction[0,-1,0,1]*(1+0.025*$bounce-0.062*$bounce*$bounce) 83.333%:$direction[0,-1,0,1]*(1+0.001*$bounce+0.01*$bounce*$bounce) 86.667%:$direction[0,-1,0,1]*(1-0.021*$bounce+0.067*$bounce*$bounce) 90%:$direction[0,-1,0,1]*(1-0.025*$bounce+0.074*$bounce*$bounce) 93.333%:$direction[0,-1,0,1]*(1-0.014*$bounce+0.041*$bounce*$bounce) 96.6