kerf-look 1
look look.grade.cold-mono version=1 name="Cold Mono" category="Mono grades" on=clip
  doc "Monochrome toned cyan-blue; winter, isolation, and clinical scenes."
  param amount number default=1 range=0..1 doc="How strong the grade is; 0 leaves the picture alone."
  fx color.lumetri@2 look=monochrome look_intensity=100*$amount wheel_midtones_x=-0.26*$amount wheel_midtones_y=-0.15*$amount
