kerf-look 1
look look.pull-motion version=1 name="Pull Motion" category="Transitions" on=transition
  doc "Pulls the outgoing shot away toward an edge; quick scene changes."
  param direction choice options=from-north|from-east|from-south|from-west default=from-west doc="Which side the next shot comes from."
  param motion_blur number default=0.5 range=0..1 doc="How much the move smears."
  a set x={0%:0:0.3333,0,0.6667,0 50%:$direction[0,-0.5,0,0.5]:0.3333,1,0.6667,1 100%:$direction[0,-1,0,1]}
  a set y={0%:0:0.3333,0,0.6667,0 50%:$direction[0.5,0,-0.5,0]:0.3333,1,0.6667,1 100%:$direction[1,0,-1,0]}
  a set scale={0%:1 10%:0.926 20%:0.824 30%:0.767 40%:0.751 50%:0.75 60%:0.751 70%:0.767 80%:0.824 90%:0.926 100%:1}
  b set x={0%:$direction[0,1,0,-1]:0.3333,0,0.6667,0 50%:$direction[0,0.5,0,-0.5]:0.3333,1,0.6667,1 100%:0}
  b set y={0%:$direction[-1,0,1,0]:0.3333,0,0.6667,0 50%:$direction[-0.5,0,0.5,0]:0.3333,1,0.6667,1 100%:0}
  b set scale={0%:1 10%:0.926 20%:0.824 30%:0.767 40%:0.751 50%:0.75 60%:0.751 70%:0.767 80%:0.824 90%:0.926 100%:1}
  a set shutter={0%:0 5%:432*$motion_blur 95%:432*$motion_blur 100%:0}
  b set shutter={0%:0 5%:432*$motion_blur 95%:432*$motion_blur 100%:0}
