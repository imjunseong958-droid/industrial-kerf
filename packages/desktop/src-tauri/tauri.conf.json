{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cut",
  "version": "0.1.0",
  "identifier": "com.cut.editor",
  "build": {
    "beforeDevCommand": "npm --workspace @cut/gui run dev -- --mode desktop --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:4174",
    "beforeBuildCommand": "npm --workspace @cut/gui run build -- --mode desktop",
    "frontendDist": "../../gui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cut · Agentic video editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; connect-src 'self'; media-src 'self' asset: blob:; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**", "$HOME/**", "$CWD/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
