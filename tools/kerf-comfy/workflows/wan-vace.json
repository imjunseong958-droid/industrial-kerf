{
  "kerf-comfy": 1,
  "about": "Wan 2.1 VACE: a shot that follows a guide video, a reference picture, both, or the prompt alone. Of a guide it follows depth best: draw it with pass=depth.",
  "fps": 16,
  "frames": { "most": 81, "step": 4 },
  "size": [832, 480],
  "multiple": 16,
  "set": {
    "negative": "blurry, low quality, static, text, watermark",
    "steps": 20,
    "cfg": 6.0,
    "shift": 8.0,
    "strength": 1.0,
    "cache": 0.2,
    "sampler": "uni_pc",
    "scheduler": "simple",
    "unet": "wan2.1_vace_1.3B_fp16.safetensors",
    "vae": "wan_2.1_vae.safetensors",
    "text_encoder": "umt5_xxl_fp16.safetensors"
  },
  "workflow": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{unet}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{text_encoder}", "type": "wan" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{vae}" } },
    "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{prompt}" } },
    "5": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{negative}" } },
    "6": { "class_type": "LoadVideo", "inputs": { "file": "{guide}" } },
    "7": { "class_type": "GetVideoComponents", "inputs": { "video": ["6", 0] } },
    "8": { "class_type": "LoadImage", "inputs": { "image": "{ref}" } },
    "9": {
      "class_type": "WanVaceToVideo",
      "inputs": {
        "positive": ["4", 0],
        "negative": ["5", 0],
        "vae": ["3", 0],
        "width": "{width}",
        "height": "{height}",
        "length": "{frames}",
        "batch_size": 1,
        "strength": "{strength}",
        "control_video": ["7", 0],
        "reference_image": ["8", 0]
      }
    },
    "10": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": "{shift}" } },
    "11": {
      "class_type": "EasyCache",
      "inputs": { "model": ["10", 0], "reuse_threshold": "{cache}", "start_percent": 0.15, "end_percent": 0.95, "verbose": false }
    },
    "12": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["11", 0],
        "positive": ["9", 0],
        "negative": ["9", 1],
        "latent_image": ["9", 2],
        "seed": "{seed}",
        "steps": "{steps}",
        "cfg": "{cfg}",
        "sampler_name": "{sampler}",
        "scheduler": "{scheduler}",
        "denoise": 1.0
      }
    },
    "13": { "class_type": "TrimVideoLatent", "inputs": { "samples": ["12", 0], "trim_amount": ["9", 3] } },
    "14": { "class_type": "VAEDecode", "inputs": { "samples": ["13", 0], "vae": ["3", 0] } },
    "15": { "class_type": "CreateVideo", "inputs": { "images": ["14", 0], "fps": "{fps}" } },
    "16": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["15", 0], "filename_prefix": "video/kerf", "format": "auto", "format.codec": "auto" }
    }
  }
}
