{
  "kerf-comfy": 1,
  "about": "How near each pixel of a guide is, as a grey video of the guide's own size, rate, and frames, nearer whiter, each frame stretched to its own nearest and farthest. output=normal_opengl gives which way each pixel faces, output=mask what is not sky. refine_steps=1 is 2.5 times as fast, for a very long shot.",
  "of": "guide",
  "frames": { "most": 480, "step": 1 },
  "size": [1920, 1080],
  "multiple": 2,
  "set": {
    "model": "moge_3_vitl_fp16.safetensors",
    "output": "depth",
    "refine_steps": 3,
    "resolution_level": 9,
    "batch": 4
  },
  "workflow": {
    "1": { "class_type": "LoadVideo", "inputs": { "file": "{guide}" } },
    "2": { "class_type": "GetVideoComponents", "inputs": { "video": ["1", 0] } },
    "3": { "class_type": "LoadMoGeModel", "inputs": { "model_name": "{model}" } },
    "4": {
      "class_type": "MoGeInference",
      "inputs": {
        "moge_model": ["3", 0],
        "image": ["2", 0],
        "resolution_level": "{resolution_level}",
        "fov_x_degrees": 0.0,
        "batch_size": "{batch}",
        "force_projection": true,
        "apply_mask": true,
        "refine_steps": "{refine_steps}"
      }
    },
    "5": { "class_type": "MoGeRender", "inputs": { "moge_geometry": ["4", 0], "output": "{output}" } },
    "6": { "class_type": "CreateVideo", "inputs": { "images": ["5", 0], "fps": "{fps}" } },
    "7": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["6", 0], "filename_prefix": "video/kerf", "format": "auto", "format.codec": "auto" }
    }
  }
}
