{
  "kerf-comfy": 1,
  "about": "Depth Anything 3, a guide's frames together as views of one scene: where the camera was on each frame, as a .txt (out={cameras.txt}), or the depth it then agrees on across the frames, as a video (out={depth.mp4}). At most 81 frames.",
  "of": "guide",
  "frames": { "most": 81, "step": 1 },
  "size": [1920, 1080],
  "multiple": 2,
  "set": {
    "model": "depth_anything_3_base.safetensors",
    "resolution": 504,
    "normalization": "v2_style",
    "anchor": "saddle_balanced",
    "pose": "cam_dec"
  },
  "workflow": {
    "1": { "class_type": "LoadVideo", "inputs": { "file": "{guide}" } },
    "2": { "class_type": "GetVideoComponents", "inputs": { "video": ["1", 0] } },
    "3": { "class_type": "LoadDA3Model", "inputs": { "model_name": "{model}", "weight_dtype": "fp32" } },
    "4": {
      "class_type": "DA3Inference",
      "inputs": {
        "da3_model": ["3", 0],
        "image": ["2", 0],
        "resolution": "{resolution}",
        "resize_method": "upper_bound_resize",
        "mode": "multiview",
        "mode.ref_view_strategy": "{anchor}",
        "mode.pose_method": "{pose}"
      }
    },
    "5": {
      "class_type": "DA3Render",
      "inputs": {
        "da3_geometry": ["4", 0],
        "output": "depth",
        "output.normalization": "{normalization}",
        "output.apply_sky_clip": false
      }
    },
    "6": { "class_type": "CreateVideo", "inputs": { "images": ["5", 0], "fps": "{fps}" } },
    "7": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["6", 0], "filename_prefix": "video/kerf", "format": "auto", "format.codec": "auto" }
    },
    "8": { "class_type": "PreviewAny", "inputs": { "source": ["4", 0] } },
    "9": { "class_type": "SaveText", "inputs": { "text": ["8", 0], "filename_prefix": "kerf-cameras", "format": "txt" } }
  }
}
