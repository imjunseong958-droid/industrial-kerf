kerf 1
project name="Scenes of solids"

media snowman_shot path="shots/snowman.mp4" rate=16 dur=00:00:05:01 video=832x480
  render snowman {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="a snowman with a black top hat, a carrot nose and stick arms stands in a snowy field with dark green pine trees at sunrise, long blue shadows on the snow, the camera circles around it, cinematic, photorealistic" guide={guide.mp4} seed=7
media rocket_shot path="shots/rocket.mp4" rate=16 dur=00:00:05:01 video=832x480
  render rocket {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="a white rocket with red fins lifts off from a concrete launch pad beside a red steel tower, fire and billowing white smoke under it, clear blue sky, the camera tilts up after it, cinematic, photorealistic" guide={guide.mp4} seed=7
media solar_shot path="shots/solar.mp4" rate=16 dur=00:00:05:01 video=832x480
  render solar {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="planets orbit a blazing yellow sun in deep black space full of stars: a blue earth, a red mars, a small grey mercury and a tan gas giant with rings, cinematic space documentary" guide={guide.mp4} seed=7
media robot_shot path="shots/robot.mp4" rate=16 dur=00:00:05:01 video=832x480
  render robot {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="a chunky retro tin toy robot with a yellow body, a silver head and glowing cyan eyes walks toward the camera down a narrow alley between dark buildings at night, wet pavement, neon reflections, cinematic" guide={guide.mp4} seed=7
media city_shot path="shots/city.mp4" rate=16 dur=00:00:05:01 video=832x480
  render city {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="aerial drone shot flying between glass skyscrapers of a futuristic city at golden hour, orange sky, a tall white spire ahead, cinematic, photorealistic" guide={guide.mp4} seed=7
media saucer_shot path="shots/saucer.mp4" rate=16 dur=00:00:05:01 video=832x480
  render saucer {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="a silver flying saucer with a glowing cyan dome flies in over a red barn and a grain silo at night and shines a green beam of light down on a white cow standing in a dark green field, starry dark blue sky, 1950s science fiction film" guide={guide.mp4} seed=7
media lighthouse_shot path="shots/lighthouse.mp4" rate=16 dur=00:00:05:01 video=832x480
  render lighthouse {guide.mp4} pass=depth size=832x480 rate=16
  generate model=shot prompt="a white lighthouse with a red cap and a glowing yellow lamp beside a small white house on a brown rocky cliff above a dark blue sea at dusk, the camera rises and circles, cinematic, photorealistic" guide={guide.mp4} seed=7
media bowling_shot path="shots/bowling.mp4" rate=16 dur=00:00:05:01 video=832x480
  render bowling {guide.mp4} pass=depth size=832x480 rate=16
  generate model=directed prompt="a glossy dark blue bowling ball rolls down a polished wooden bowling lane and smashes into white bowling pins, the pins fly apart on the strike, dark bowling alley, cinematic slow motion" guide={guide.mp4} signal=strike moves=ball seed=7
media donut_shot path="shots/donut.mp4" rate=16 dur=00:00:05:01 video=832x480
